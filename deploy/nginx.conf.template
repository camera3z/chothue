# Replace RENTAL_DOMAIN and RELEASE_PATH before installing as a separate vhost.
# RELEASE_PATH must be an absolute path to the extracted static build.
server {
    listen 80;
    listen [::]:80;
    server_name RENTAL_DOMAIN;
    root RELEASE_PATH;
    index index.html;
    server_tokens off;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options DENY always;

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }

    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location ~ /\. {
        deny all;
    }
}
